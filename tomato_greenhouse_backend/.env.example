# Set these in Render's Environment dashboard for deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-unique-password
AUTH_SECRET=replace-with-random-secret-at-least-32-characters
DEVICE_API_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGINS=https://YOUR-PROJECT.vercel.app
